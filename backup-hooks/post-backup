#!/bin/bash
if [ "$1" = "post-backup" ]; then
  LATEST_BACKUP=$(ls -t /backups/last/*.sql.gz 2>/dev/null | head -1)
  if [ -n "$LATEST_BACKUP" ] && [ -n "$BACKUP_CHANNEL_ID" ] && [ -n "$BACKUP_BOT_TOKEN" ]; then
    curl -s -F chat_id="$BACKUP_CHANNEL_ID" \
      -F "caption=Leadly DB Backup | $(date '+%Y-%m-%d %H:%M') | $(basename $LATEST_BACKUP)" \
      -F document=@"$LATEST_BACKUP" \
      "https://api.telegram.org/bot$BACKUP_BOT_TOKEN/sendDocument"
  fi
fi
