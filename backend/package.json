{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "bun dist/index.js",
    "start:worker": "bun dist/workers/reddit.worker.js",
    "dev": "bun --watch src/index.ts",
    "worker": "bun --watch src/workers/reddit.worker.ts",
    "worker:dev": "bun src/workers/reddit.worker.ts > output.log 2>&1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "typecheck": "tsc",
    "lint": "bunx prettier --check .",
    "lint:fix": "bunx prettier --write .",
    "seed": "bun src/scripts/seed.ts",
    "blog:generate": "bun src/scripts/manual-generate-blog.ts",
    "blog:backlog": "bun src/scripts/generate-blog-backlog.ts 8",
    "build": "bun build ./src/index.ts ./src/workers/reddit.worker.ts --outdir ./dist --minify --target bun --external 'node_modules'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/cerebras": "^2.0.20",
    "@ai-sdk/google": "^3.0.16",
    "@ai-sdk/openai-compatible": "^2.0.18",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "ai": "^6.0.59",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dodopayments": "^2.17.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "he": "^1.2.0",
    "ioredis": "^5.9.2",
    "node-cron": "^4.2.1",
    "playwright": "^1.58.0",
    "resend": "^6.8.0",
    "slugify": "^1.6.6",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/he": "^1.2.3",
    "@types/node": "^24.10.9",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3"
  }
}
