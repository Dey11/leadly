# Database
DATABASE_URL="postgresql://username:password@host:port/db?sslmode=require&channel_binding=require&connect_timeout=15&pool_timeout=15"

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=your_session_secret
FRONTEND_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username

# Nitter (for scraping)
NITTER_URL=

# AI Providers - Primary
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key

# AI Providers - Fallback (optional but recommended for reliability)
CEREBRAS_API_KEY=your_cerebras_api_key
NEBIUS_API_KEY=your_nebius_api_key

# Dodo Payments
DODO_API_KEY=your_dodo_api_key
DODO_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PRO_PRODUCT_ID=your_dodo_pro_product_id
DODO_PREMIUM_PRODUCT_ID=your_dodo_premium_product_id

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Discord Webhooks (optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url
DISCORD_PAYMENT_WEBHOOK_URL=your_discord_payment_webhook_url
DISCORD_LOGS_WEBHOOK_URL=your_discord_logs_webhook_url

# Admin (generate with: openssl rand -hex 32)
ADMIN_API_KEY=your_admin_api_key_min_32_chars

# Feature Flags (optional - defaults based on NODE_ENV)
# FEATURE_BILLING_ENFORCEMENT=on  # "on" | "log" | "off"
# LOG_LEVEL=info                   # "error" | "warn" | "info" | "debug"

# Webhooks (optional)
# WEBHOOK_PUBLIC_URL=https://your-domain.com