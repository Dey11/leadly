generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  REDDIT
  // TWITTER
}

enum LeadType {
  WARM
  COLD
  NEUTRAL
}

enum MonitorStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum LeadStatus {
  NEW
  VIEWED
  CONTACTED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum BugReportCategory {
  BUG
  FEATURE_REQUEST
  QUESTION
  OTHER
}

enum BugReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  restricted   Boolean  @default(false)
  isDeleted    Boolean  @default(false)

  subscription      Subscription?
  schedule          UserSchedule?
  keywordSchedule   KeywordSchedule?

  monitors        Monitor[]
  keywordMonitors KeywordMonitor[]
  icps            Icp[]
  keywordSets     KeywordSet[]
  usage           Usage?
  bugReports      BugReport[]

  name                String
  emailVerified       Boolean   @default(false)
  emailOtp            String?
  emailOtpExpiresAt   DateTime?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  image               String?
  sessions            Session[]
  accounts            Account[]
  hasSeenWalkthrough  Boolean   @default(false)

  @@map("users")
}

model BugReport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String             @db.Text
  category    BugReportCategory
  severity    BugReportSeverity?
  pageUrl     String?
  status      BugReportStatus    @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("bug_reports")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionCustomerId String? @unique
  subscriptionId         String? @unique
  subscriptionPriceId    String?
  billingName            String?
  billingEmail           String?
  billingPhone           String?
  billingAddress         String? @db.Text

  status           SubscriptionStatus
  tier             SubscriptionTier   @default(FREE)
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Icp {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  summary              String        @db.Text
  targetPersona        String        @db.Text
  pains                String        @db.Text
  valueProposition     String        @db.Text
  qualifyingSignals    String        @db.Text
  disqualifyingSignals String        @db.Text
  platform             Platform
  status               MonitorStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitors Monitor[]

  @@index([userId])
  @@map("icps")
}

model UserSchedule {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduledHours Int[] // Array of hours 0-23

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_schedules")
}

model KeywordSchedule {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduledHours Int[] // Array of hours 0-23

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("keyword_schedules")
}

model KeywordSet {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  keywords String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keywordMonitors KeywordMonitor[]

  @@index([userId])
  @@map("keyword_sets")
}

model Monitor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  icpId String
  icp   Icp    @relation(fields: [icpId], references: [id], onDelete: Cascade)

  platform Platform
  target   String
  cursor   String?

  status MonitorStatus @default(ACTIVE)

  lastScrapedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scrapeJobs ScrapeJob[]
  failedJobs FailedScrapeJob[]

  @@index([userId])
  @@index([icpId])
  @@map("monitors")
}

model ScrapeJob {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  status       ScrapeJobStatus @default(PENDING)
  errorMessage String?         @db.Text
  metadata     Json? // to store the reddit cursor
  warmLeads    Int             @default(0)
  coldLeads    Int             @default(0)
  neutralLeads Int             @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  retryCount  Int       @default(0)
  nextRetryAt DateTime?

  createdAt DateTime @default(now())

  leads Lead[]

  @@index([monitorId])
  @@index([status, retryCount, nextRetryAt])
  @@index([createdAt])
  @@map("scrape_jobs")
}

model FailedScrapeJob {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  originalJobId String   @unique
  errorMessage  String   @db.Text
  failedAt      DateTime @default(now())
  metadata      Json?

  reviewed    Boolean @default(false)
  reviewNotes String? @db.Text

  @@index([monitorId])
  @@index([reviewed])
  @@map("failed_scrape_jobs")
}

model Lead {
  id          String    @id @default(cuid())
  scrapeJobId String
  scrapeJob   ScrapeJob @relation(fields: [scrapeJobId], references: [id], onDelete: Cascade)

  platform  Platform
  leadType  LeadType
  content   String   @db.Text
  url       String   @unique
  author    String?
  reasoning String?  @db.Text

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scrapeJobId])
  @@index([status])
  @@index([leadType])
  @@index([createdAt])
  @@map("leads")
}

// ==================== KEYWORD MODE MODELS ====================

model KeywordMonitor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  keywordSetId String
  keywordSet   KeywordSet @relation(fields: [keywordSetId], references: [id], onDelete: Cascade)

  platform Platform @default(REDDIT)
  target   String
  cursor   String?

  status MonitorStatus @default(ACTIVE)

  lastScrapedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scrapeJobs KeywordScrapeJob[]

  @@index([userId])
  @@index([keywordSetId])
  @@map("keyword_monitors")
}

model KeywordScrapeJob {
  id               String         @id @default(cuid())
  keywordMonitorId String
  keywordMonitor   KeywordMonitor @relation(fields: [keywordMonitorId], references: [id], onDelete: Cascade)

  status       ScrapeJobStatus @default(PENDING)
  errorMessage String?         @db.Text
  metadata     Json?
  matchCount   Int             @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  retryCount  Int       @default(0)
  nextRetryAt DateTime?

  createdAt DateTime @default(now())

  leads KeywordLead[]

  @@index([keywordMonitorId])
  @@index([status, retryCount, nextRetryAt])
  @@index([createdAt])
  @@map("keyword_scrape_jobs")
}

model KeywordLead {
  id          String          @id @default(cuid())
  scrapeJobId String
  scrapeJob   KeywordScrapeJob @relation(fields: [scrapeJobId], references: [id], onDelete: Cascade)

  platform        Platform
  content         String   @db.Text
  url             String   @unique
  author          String?
  matchedKeywords String[]

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scrapeJobId])
  @@index([status])
  @@index([createdAt])
  @@map("keyword_leads")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Usage {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Monthly window
  periodStart DateTime
  periodEnd   DateTime
  scrapesUsed Int      @default(0)

  // Daily window (UTC day)
  dailyDate  DateTime
  dailyCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("usage")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}
